@{
    ViewData["Title"] = "Search Transactions";
}

<h2>🔍 Search Transactions</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="List" method="post" class="mt-3">
    <div class="mb-3">
        <label class="form-label">Enter Account ID</label>
        <input type="number" name="accountId" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">View Transactions</button>
    <a asp-controller="BankAccount" asp-action="Index" class="btn btn-secondary">Back</a>
</form>
