@model IEnumerable<BankAccount>

@{
    ViewData["Title"] = "Bank Accounts";
}

<h2 class="mb-3">Bank Accounts</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ Create Account</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Account Number</th>
            <th>Account Holder</th>
            <th>Balance</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Model)
        {
            <tr>
                <td>@account.Id</td>
                <td>@account.AccountNumber</td>
                <td>@account.AccountHolder</td>
                <td>Rs. @account.Balance</td>
                <td>
                    <a asp-action="Deposit" asp-route-id="@account.Id" class="btn btn-success btn-sm">Deposit</a>
                    <a asp-action="Withdraw" asp-route-id="@account.Id" class="btn btn-warning btn-sm">Withdraw</a>
                    <a asp-controller="Transaction" asp-action="List" asp-route-accountId="@account.Id" class="btn btn-info btn-sm">
                        View Transactions
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
