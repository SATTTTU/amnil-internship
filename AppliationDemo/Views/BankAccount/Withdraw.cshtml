@model AppliationDemo.Models.BankAccount

@{
    ViewData["Title"] = "Withdraw";
}

<h2>Withdraw from Account</h2>

<form asp-action="Withdraw" method="post">
    <input type="hidden" name="AccountId" value="@Model.Id" />
    <div class="mb-3">
        <label class="form-label">Amount to Withdraw</label>
        <input name="Amount" type="number" step="0.01" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-danger">Withdraw</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
