@model BankAccount

@{
    ViewData["Title"] = "Deposit";
}

<h2>Deposit to Account</h2>

<form asp-action="Deposit" method="post">
    <input type="hidden" name="AccountId" value="@Model.Id" /> 
    <div class="mb-3">
        <label class="form-label">Amount to Deposit</label>
        <input name="Amount" type="number" step="0.01" class="form-control" required /> 
    </div>
    <button type="submit" class="btn btn-success">Deposit</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
